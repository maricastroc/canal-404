{
  "name": "canal-404",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "og": "node scripts/og-images.mjs",
    "postinstall": "prisma generate",
    "db:up": "docker compose up -d --wait db",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "test:db": "TEST_DATABASE_URL=${TEST_DATABASE_URL:-postgresql://canal404:canal404@localhost:54404/canal404_test} vitest run --project server"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@vercel/functions": "^3.10.6",
    "lucide": "^1.61.0",
    "lucide-react": "^1.61.0",
    "matter-js": "0.20.0",
    "motion": "^12.43.0",
    "next": "16.4.3",
    "pg": "^8.23.1",
    "phaser": "^3.90.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@types/matter-js": "^0.20.2",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^18.0.9",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "jsdom": "^30.1.3",
    "prisma": "^7.10.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.5"
  }
}
